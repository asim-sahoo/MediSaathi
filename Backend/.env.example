# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Connection String
# For local development, leave empty to use in-memory MongoDB
# For production, use your MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com
MONGO_CONN=mongodb+srv://username:password@cluster.mongodb.net/medisaathi

# JWT Secret Key
# IMPORTANT: Change this to a strong random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secure_jwt_secret_key_change_this_in_production

# Google Gemini AI API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Python FastAPI Service URL (X-ray detection)
# Local: http://localhost:8000/detect
# Production: https://medisaathi-ai.onrender.com/detect
PY_DETECT_URL=http://localhost:8000/detect

# Frontend URL (for CORS in production)
FRONTEND_URL=https://medisaathi.vercel.app
