# Frontend Environment Variables

# API Base URL - points to the backend server
# For local development with Node.js backend (server.js)
VITE_API_URL=http://localhost:8080

# If you're using the FastAPI backend for X-ray detection only, 
# you can keep the Node.js backend for authentication and use:
# VITE_API_URL=http://localhost:8080
# VITE_FASTAPI_URL=http://localhost:8000
